{
  "name": "buildwithcli",
  "version": "1.0.0",
  "private": true,
  "description": "A provider-neutral catalog and deterministic compiler for OpenCode, Hermes Agent, Codex CLI, GitHub Copilot CLI, Claude Code, and other agent CLIs.",
  "main": "index.js",
  "scripts": {
    "test": "npm run validate && npm run test:unit && npm run test:portable",
    "test:unit": "node --test scripts/github-search-pagination.test.js && node --experimental-strip-types --test web-ui/lib/indexer/search-pagination.test.ts",
    "test:integration": "./tests/plugin-test-harness.sh",
    "validate": "node scripts/validate-all.js",
    "validate:subagents": "node scripts/validate-subagents.js",
    "validate:hooks": "node scripts/validate-hooks.js",
    "generate:registry": "node scripts/generate-registry.js",
    "fetch:plugins": "node scripts/fetch-plugins.js",
    "fetch:all": "npm run fetch:plugins && npm run generate:registry",
    "start": "node web-ui/server.js",
    "portable": "node bin/buildwithcli.js",
    "portable:doctor": "node bin/buildwithcli.js doctor",
    "portable:scan": "node bin/buildwithcli.js scan --profile curated",
    "portable:compile": "node bin/buildwithcli.js compile --target all --profile curated --out .buildwithcli/dist",
    "validate:portable": "node scripts/validate-portability.js",
    "test:portable": "node scripts/run-portability-tests.js"
  },
  "workspaces": [
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groxaxo/buildwithcli.git"
  },
  "keywords": [
    "agent-skills",
    "opencode",
    "hermes-agent",
    "codex-cli",
    "copilot-cli",
    "claude-code",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/groxaxo/buildwithcli/issues"
  },
  "homepage": "https://github.com/groxaxo/buildwithcli#readme",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {},
  "bin": {
    "buildwithcli": "bin/buildwithcli.js"
  },
  "engines": {
    "node": ">=20"
  }
}
