{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildWithCLI Agent Skill Schema",
  "description": "Schema for portable Agent Skills used across supported CLI hosts",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier for the skill (lowercase, hyphen-separated). Must match the directory name."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Clear description of when this skill should be used"
    },
    "category": {
      "type": "string",
      "enum": [
        "ai-agents",
        "ai-ml",
        "analytics",
        "automation",
        "business-productivity",
        "communication",
        "creative-collaboration",
        "crm",
        "customer-support",
        "data-engineering",
        "design",
        "development-code",
        "devops",
        "document-processing",
        "ecommerce",
        "email",
        "finance",
        "infrastructure-cloud",
        "media-content",
        "observability",
        "project-management",
        "research",
        "security",
        "social-media",
        "storage-docs",
        "testing-qa",
        "uncategorized"
      ],
      "description": "Category for organizing the skill"
    },
    "allowed-tools": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ],
      "description": "Host tool allow-list; an explicit empty value remains restrictive"
    },
    "model": {
      "type": "string",
      "description": "Preferred model (opus | sonnet | haiku)"
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g. MIT)"
    },
    "requires": {
      "type": "object",
      "description": "Runtime dependencies, e.g. { \"mcp\": [\"rube\"] }"
    },
    "compatibility": {
      "type": "string",
      "maxLength": 500,
      "description": "Runtime or host compatibility requirements"
    },
    "metadata": {
      "type": "object",
      "description": "Portable scalar metadata",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "argument-hint": {
      "type": "string",
      "description": "Arguments displayed for user-invocable skills"
    },
    "user-invocable": {
      "type": "boolean",
      "description": "Whether a user can invoke the skill explicitly"
    },
    "disable-model-invocation": {
      "type": "boolean",
      "description": "Prevent automatic model invocation"
    }
  },
  "required": [
    "name",
    "description",
    "category"
  ],
  "additionalProperties": false
}
